// FILE: test/ZZZ_FastKeccak170.sol
// EIP-170-DEPLOYABLE fast Keccak-f[1600] permutation + minimal SHAKE256 XOF.
//
// The helper runtime (21622 bytes) has TWO entry points, dispatched on
// calldatasize:
//   * calldatasize == 800 (raw permutation, the original protocol): 25 lanes
//     in via calldata / 800-byte permuted state out;
//   * anything else (batched SHAKE256): calldata is the raw message; the
//     helper pads (FIPS 202), absorbs and permutes per 136-byte rate block,
//     and returns the first 136-byte squeeze block in ONE call.
// Inside, the fully unrolled 24-round lane-complemented permutation CORE
// (committed pristine as helpers/f1600_core.hex, 19617 bytes) runs in place
// on the state at 0x320..0x640 with a ping-pong buffer at 0x000..0x320.
//
// Provenance of _F1600_CODE_170 (fully reproducible):
//   * PERMUTATION CORE (helpers/f1600_core.hex, sha256 46fbc67c...8764ee,
//     pinned in tools/build_f1600_batch.py): generated Yul object from
//     gen170.py, variant "170_global_a0" -- reuses the beam-searched
//     lane-complement plan of gen_ext3.py (chi as and/or/andnot forms, ~19 of
//     25 NOTs removed per round, flags provably zero after round 23); the
//     64-bit lane mask in a top-level Yul variable so each of its ~700 uses is
//     a 1-byte DUPn (this is what brought the 25357-byte build under EIP-170);
//     compiled solc 0.8.30 --strict-assembly --optimize --optimize-runs 10000
//     --yul-optimizations ':' --evm-version osaka; byte-patched (`PUSH1 1 DUP1
//     PUSH1 64 SHL SUB` mask reconstruction -> `PUSH8 mask`); straight-line
//     (no JUMP/JUMPDEST), verified by mini-EVM vs the FIPS-202 Python model.
//     (The generator scripts are NOT PRESERVED; the core is therefore pinned
//     as a verbatim artifact and re-verified behaviorally on every build and
//     in this suite.)
//   * SHIPPED RUNTIME: deterministically rebuilt from the core by
//     tools/build_f1600_batch.py -- six mechanical patches (round-1 state
//     reads calldata->memory+0x320; five leftover `PUSH1 a; PUSH1 1;
//     PUSH1 s; SHL; SUB` iota-constant reconstructions -> a single PUSH,
//     -60 gas/permutation; trailing RETURN stripped; the top-level 64-bit
//     lane-mask variable widened to all-256-bits; all 696 `DUPn(mask); AND`
//     rotation fixups DELETED; the 24 iota constants 4-fold replicated) plus
//     the dispatcher/absorb/squeeze wrapper.
//
//     The last three are "Q-FORM": the state words hold each lane 4-FOLD
//     REPLICATED (v | v<<64 | v<<128 | v<<192), which makes the 256-bit word
//     its own rotation ring -- or(shl(r,W), shr(64-r,W)) IS the replicated
//     rotation, with NO masking, because the bits SHL pushes past bit 255 are
//     exactly the ones SHR brings back -- while every other Keccak step is
//     bitwise and so preserves the 64-periodicity. 29 rotations x 24 rounds of
//     mask fixups therefore vanish: -4,176 gas and -1,392 bytes. Deleting a
//     `DUP; AND` pair is stack-depth-neutral, which is what makes this safe to
//     do on pinned bytecode. The lift is confined to the callee (raw entry
//     lifts from calldata, raw exit masks; batch keeps Q-form resident across
//     rate blocks), so BOTH protocols are unchanged byte-for-byte -- callers
//     still pass and receive clean 64-bit lanes and cannot observe Q-form.
//
//     The builder self-verifies: raw path vs the FIPS-202 model AND vs the
//     unpatched core binary on 20 chained states (callee gas 41373); a Q-FORM
//     INVARIANT PROBE that reads the 25 state words out of the mini-EVM after
//     the entry lift and after the last round and requires each to be exactly
//     the 4-fold replication of the model's lane; batch path vs
//     hashlib.shake_256 on 14 block-boundary lengths. Re-derive and compare
//     with: python3 tools/build_f1600_batch.py --check
//   * verified continuously by the reference cross-check, the SHAKE256 KATs
//     and the batch-vs-lane-sponge equivalence tests in
//     test/ZZZ_fastkeccak170.t.sol against src f1600.
//
// Deployment: REAL bytecode deployment -- deployF1600_170() wraps the runtime
// in an 11-byte init stub and CREATEs it (no vm.etch anywhere):
//     PUSH2 rtLen; DUP1; PUSH2 11; PUSH0; CODECOPY; PUSH0; RETURN
// All permutation/sponge functions take the deployed helper address as a
// parameter and are `view` (they staticcall the helper).
//
// State: 25 lanes, one 64-bit lane per 32-byte memory word (lanes MUST be < 2**64).
pragma solidity ^0.8.25;

uint256 constant _M64_170 = 0xffffffffffffffff;

/// @dev Keccak-f[1600] helper runtime, 21622 bytes (see provenance above).
bytes constant _F1600_CODE_170 =
    hex"";

/// @notice Deploy the f1600 helper via plain CREATE with a minimal init-code
///         wrapper (PUSH2 len; DUP1; PUSH2 11; PUSH0; CODECOPY; PUSH0; RETURN).
///         Real deployment: subject to the EVM's EIP-170 runtime size check.
function deployF1600_170() returns (address helper) {
    bytes memory runtime = _F1600_CODE_170;
    bytes memory initCode =
        abi.encodePacked(hex"61", uint16(runtime.length), hex"8061000b5f395ff3", runtime);
    assembly ("memory-safe") {
        helper := create(0, add(initCode, 32), mload(initCode))
    }
    require(helper != address(0), "f1600-170: CREATE failed");
}

/// @notice Keccak-f[1600] permutation, in place on `st` (25 words, lane i = x + 5*y).
/// @dev staticcalls `helper` (a deployF1600_170() deployment) with `st` as both
///      the argument and the return buffer -- zero-copy in-place permutation.
function f1600Fast170(uint256[25] memory st, address helper) view {
    bool ok;
    assembly ("memory-safe") {
        ok := staticcall(gas(), helper, st, 800, st, 800)
        ok := and(ok, eq(returndatasize(), 800))
    }
    require(ok, "f1600-170: helper call failed");
}

/// @dev XOR one 136-byte rate block at memory `ptr` into the sponge state (lanes 0..16).
///      Whole-word loads + in-word byte reversal per 8-byte group; no byte loops.
///      Reads 160 bytes at ptr (the trailing 24 bytes of the last mload are ignored).
function _xorBlockFast170(uint256[25] memory st, uint256 ptr) pure {
    assembly {
        // reverse the byte order inside each 8-byte group of a 32-byte word
        function grev(w) -> v {
            v := or(
                and(shl(8, w), 0xff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00),
                and(shr(8, w), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)
            )
            v := or(
                and(shl(16, v), 0xffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000),
                and(shr(16, v), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)
            )
            v := or(
                and(shl(32, v), 0xffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000),
                and(shr(32, v), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff)
            )
        }
        let v := grev(mload(ptr)) // input bytes 0..31 -> lanes 0..3
        mstore(st, xor(mload(st), shr(192, v)))
        mstore(add(st, 32), xor(mload(add(st, 32)), and(shr(128, v), _M64_170)))
        mstore(add(st, 64), xor(mload(add(st, 64)), and(shr(64, v), _M64_170)))
        mstore(add(st, 96), xor(mload(add(st, 96)), and(v, _M64_170)))
        v := grev(mload(add(ptr, 32))) // lanes 4..7
        mstore(add(st, 128), xor(mload(add(st, 128)), shr(192, v)))
        mstore(add(st, 160), xor(mload(add(st, 160)), and(shr(128, v), _M64_170)))
        mstore(add(st, 192), xor(mload(add(st, 192)), and(shr(64, v), _M64_170)))
        mstore(add(st, 224), xor(mload(add(st, 224)), and(v, _M64_170)))
        v := grev(mload(add(ptr, 64))) // lanes 8..11
        mstore(add(st, 256), xor(mload(add(st, 256)), shr(192, v)))
        mstore(add(st, 288), xor(mload(add(st, 288)), and(shr(128, v), _M64_170)))
        mstore(add(st, 320), xor(mload(add(st, 320)), and(shr(64, v), _M64_170)))
        mstore(add(st, 352), xor(mload(add(st, 352)), and(v, _M64_170)))
        v := grev(mload(add(ptr, 96))) // lanes 12..15
        mstore(add(st, 384), xor(mload(add(st, 384)), shr(192, v)))
        mstore(add(st, 416), xor(mload(add(st, 416)), and(shr(128, v), _M64_170)))
        mstore(add(st, 448), xor(mload(add(st, 448)), and(shr(64, v), _M64_170)))
        mstore(add(st, 480), xor(mload(add(st, 480)), and(v, _M64_170)))
        v := grev(mload(add(ptr, 128))) // lane 16 (bytes 128..135 only)
        mstore(add(st, 512), xor(mload(add(st, 512)), shr(192, v)))
    }
}

/// @dev Write one full 136-byte squeeze block from the state to memory at `outPtr`.
///      Writes 160 bytes (the last word spills 24 bytes of garbage past the block);
///      callers must only consume 136 bytes and may let later writes overwrite the rest.
function _squeezeBlockFast170(uint256[25] memory st, uint256 outPtr) pure {
    assembly {
        function grev(w) -> v {
            v := or(
                and(shl(8, w), 0xff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00),
                and(shr(8, w), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)
            )
            v := or(
                and(shl(16, v), 0xffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000),
                and(shr(16, v), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)
            )
            v := or(
                and(shl(32, v), 0xffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000),
                and(shr(32, v), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff)
            )
        }
        mstore(
            outPtr,
            grev(or(or(or(shl(192, mload(st)), shl(128, mload(add(st, 32)))), shl(64, mload(add(st, 64)))), mload(add(st, 96))))
        )
        mstore(
            add(outPtr, 32),
            grev(
                or(
                    or(or(shl(192, mload(add(st, 128))), shl(128, mload(add(st, 160)))), shl(64, mload(add(st, 192)))),
                    mload(add(st, 224))
                )
            )
        )
        mstore(
            add(outPtr, 64),
            grev(
                or(
                    or(or(shl(192, mload(add(st, 256))), shl(128, mload(add(st, 288)))), shl(64, mload(add(st, 320)))),
                    mload(add(st, 352))
                )
            )
        )
        mstore(
            add(outPtr, 96),
            grev(
                or(
                    or(or(shl(192, mload(add(st, 384))), shl(128, mload(add(st, 416)))), shl(64, mload(add(st, 448)))),
                    mload(add(st, 480))
                )
            )
        )
        mstore(
            add(outPtr, 128),
            grev(
                or(
                    or(or(shl(192, mload(add(st, 512))), shl(128, mload(add(st, 544)))), shl(64, mload(add(st, 576)))),
                    mload(add(st, 608))
                )
            )
        )
    }
}

/// @notice Minimal SHAKE256 XOF built on f1600Fast170 (helper-address parameterized).
/// @dev Rate 136 bytes, 0x1f domain padding, 0x80 final bit. Absorb and squeeze are
///      word-wise (full 32-byte loads/stores with in-word byte reversal), multi-block safe.
function shake256Fast170(bytes memory input, uint256 outLen, address helper)
    view
    returns (bytes memory output)
{
    uint256[25] memory st; // zero-initialized sponge state
    uint256 ptr;
    uint256 len = input.length;
    assembly {
        ptr := add(input, 32)
    }
    unchecked {
        // absorb full 136-byte blocks
        uint256 nFull = len / 136;
        for (uint256 i = 0; i < nFull; ++i) {
            _xorBlockFast170(st, ptr);
            f1600Fast170(st, helper);
            ptr += 136;
        }
        // final (partial or empty) block with 0x1f ... 0x80 padding
        uint256 rem = len - nFull * 136;
        bytes memory last = new bytes(136); // zeroed
        assembly {
            let dst := add(last, 32)
            mcopy(dst, ptr, rem)
            mstore8(add(dst, rem), 0x1f)
            // byte 135 is the least significant byte of the word at offset 104
            mstore(add(dst, 104), xor(mload(add(dst, 104)), 0x80))
            ptr := dst
        }
        _xorBlockFast170(st, ptr);
        f1600Fast170(st, helper);

        // squeeze
        output = new bytes(outLen);
        uint256 outPtr;
        assembly {
            outPtr := add(output, 32)
        }
        uint256 done = 0;
        while (true) {
            // writes a full 136(+24 spill)-byte block; the spill lands in free memory
            // or is overwritten by the next block
            _squeezeBlockFast170(st, outPtr + done);
            done += 136;
            if (done >= outLen) break;
            f1600Fast170(st, helper);
        }
    }
}
