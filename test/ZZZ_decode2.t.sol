contract Decode2Test is Test {
    PythonSigner pythonSigner = new PythonSigner();

    function testDecode2BitEqualAndGas() public {
        (bytes memory cTildeB, bytes memory zB, bytes memory hB) = pythonSigner.sign(
            "pythonref",
            "0x1111222233334444111122223333444411112222333344441111222233334444",
            "NIST",
            Constants.SEED_POSTQUANTUM_STR
        );
        cTildeB; // silence
        uint256 g0;

        // reference decode (repo) for inputs / cross-check
        uint256[][] memory zRef = unpackZ(zB);
        (bool okRef, uint256[][] memory hRef) = unpackH(hB);
        require(okRef, "ref h");
        hRef;

        // ---------------- unpackZ: before vs after ----------------
        g0 = gasleft();
        (uint256[] memory zOld, bool normOld) = unpackZFast(zB);
        console.log("unpackZFast (before):", g0 - gasleft());

        g0 = gasleft();
        (uint256[] memory zNew, bool normNew) = unpackZFast2(zB);
        console.log("unpackZFast2 (after):", g0 - gasleft());

        assertEq(normNew, normOld, "norm flag mismatch");
        for (uint256 k = 0; k < 1024; k++) {
            assertEq(zNew[k], zOld[k], "z word mismatch");
        }
        for (uint256 i = 0; i < 4; i++) {
            for (uint256 j = 0; j < 256; j++) {
                assertEq(zNew[i * 256 + j], zRef[i][j], "z vs repo mismatch");
            }
        }

        // ---------------- useHint: before vs after ----------------
        (bool ok2, uint256[4] memory masks,) = unpackHFast(hB);
        assertTrue(ok2, "h fast");

        g0 = gasleft();
        bytes memory hintOld = useHintFast(masks, zRef);
        console.log("useHintFast (before):", g0 - gasleft());

        g0 = gasleft();
        bytes memory hintNew = useHintFast2(masks, zRef);
        console.log("useHintFast2 (after):", g0 - gasleft());

        assertEq(hintNew.length, hintOld.length, "hint length");
        assertEq(keccak256(hintNew), keccak256(hintOld), "hint bytes mismatch");
    }
}
