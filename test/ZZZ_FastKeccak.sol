// FILE: test/ZZZ_FastKeccak.sol
// Fast Keccak-f[1600] permutation + minimal SHAKE256 XOF.
//
// The permutation is a *standalone contract* (runtime bytecode embedded below as
// _F1600_CODE) that holds the whole 24-round unrolled permutation with
// compile-time-constant memory addresses (state at 0x000..0x320, ping-pong
// buffer at 0x320..0x640 of the callee's fresh memory). It reads the 25 lanes
// (one 64-bit lane per 32-byte word) from calldata and returns the permuted
// 800-byte state. f1600Fast staticcalls it with the state array passed as both
// the argument and the return buffer, so no copies happen on the caller side.
//
// Provenance of _F1600_CODE (fully reproducible):
//   * generated Yul object: gen_ext3.py, a generator script that is not
//     preserved — fully unrolled 24 rounds, constant addresses, rotations as
//     and(mask, or(shl, shr)), plus the Keccak lane-complementing transform:
//     chi emitted as and/or/andnot forms chosen by a beam search over
//     lane-complement flags (~19 of 25 NOTs removed per round; all flags
//     provably return to zero after round 23, verified at generation time)
//   * compiled: solc 0.8.30 --strict-assembly --optimize --optimize-runs 10000
//     --yul-optimizations ':' --evm-version osaka
//   * byte-patched: every `PUSH1 1 DUP1 PUSH1 64 SHL SUB` (solc's 15-gas
//     reconstruction of 0xffffffffffffffff) replaced by `PUSH8 mask` (3 gas).
//     The code is pure straight-line (no JUMP/JUMPDEST), so patching cannot
//     break offsets; asserted during generation.
//   * verified: mini-EVM execution vs the FIPS-202 Python model on random
//     states, and (continuously) by test_f1600Fast_matches_reference /
//     the SHAKE256 KATs in test/ZZZ_fastkeccak.t.sol against src f1600.
//
// Deployment: lazily `vm.etch`ed at a fixed address on first use (forge-only,
// like the rest of test/). Production use would deploy the same runtime once
// via CREATE2 and hardcode its address. f1600Fast keeps its `pure` signature by
// jumping into the view implementation through an assembly function-pointer
// cast — the exact pattern forge-std's console.sol uses
// (_castLogPayloadViewToPure).
//
// State: 25 lanes, one 64-bit lane per 32-byte memory word (lanes MUST be < 2**64).
pragma solidity ^0.8.25;

uint256 constant _M64 = 0xffffffffffffffff;

// fixed address the permutation helper is etched at (raw literal reused in assembly)
address constant _F1600_AT = address(uint160(0x00000000000000000000000000000F1600AA));
// forge vm cheatcode address = uint160(keccak256("hevm cheat code"))
address constant _FORGE_VM = address(uint160(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D));

/// @dev minimal vm interface; etch declared view so it is callable from the view
///      implementation (forge intercepts the call regardless of call kind).
interface _VmEtchLike {
    function etch(address target, bytes calldata newRuntimeBytecode) external view;
}

/// @dev Keccak-f[1600] helper runtime (see provenance in the file header).
bytes constant _F1600_CODE =
    hex"";

/// @dev view implementation: staticcall the fixed-address helper with `st` as both
///      the argument and the return buffer (zero-copy in-place permutation);
///      lazily etch the helper the first time it is missing, then retry.
function _f1600View(uint256[25] memory st) view {
    bool ok;
    assembly ("memory-safe") {
        ok := staticcall(gas(), 0xF1600AA, st, 800, st, 800)
        ok := and(ok, eq(returndatasize(), 800))
    }
    if (!ok) {
        // helper not deployed yet in this test context: etch it and retry
        _VmEtchLike(_FORGE_VM).etch(_F1600_AT, _F1600_CODE);
        assembly ("memory-safe") {
            ok := staticcall(gas(), 0xF1600AA, st, 800, st, 800)
            ok := and(ok, eq(returndatasize(), 800))
        }
        require(ok, "f1600 helper unavailable");
    }
}

/// @dev forge-std console.sol's view->pure function-pointer cast.
function _castF1600ToPure(function(uint256[25] memory) internal view fnIn)
    pure
    returns (function(uint256[25] memory) internal pure fnOut)
{
    assembly {
        fnOut := fnIn
    }
}

/// @notice Keccak-f[1600] permutation, in place on `st` (25 words, lane i = x + 5*y).
function f1600Fast(uint256[25] memory st) pure {
    _castF1600ToPure(_f1600View)(st);
}

/// @dev XOR one 136-byte rate block at memory `ptr` into the sponge state (lanes 0..16).
///      Whole-word loads + in-word byte reversal per 8-byte group; no byte loops.
///      Reads 160 bytes at ptr (the trailing 24 bytes of the last mload are ignored).
function _xorBlockFast(uint256[25] memory st, uint256 ptr) pure {
    assembly {
        // reverse the byte order inside each 8-byte group of a 32-byte word
        function grev(w) -> v {
            v := or(
                and(shl(8, w), 0xff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00),
                and(shr(8, w), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)
            )
            v := or(
                and(shl(16, v), 0xffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000),
                and(shr(16, v), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)
            )
            v := or(
                and(shl(32, v), 0xffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000),
                and(shr(32, v), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff)
            )
        }
        let v := grev(mload(ptr)) // input bytes 0..31 -> lanes 0..3
        mstore(st, xor(mload(st), shr(192, v)))
        mstore(add(st, 32), xor(mload(add(st, 32)), and(shr(128, v), _M64)))
        mstore(add(st, 64), xor(mload(add(st, 64)), and(shr(64, v), _M64)))
        mstore(add(st, 96), xor(mload(add(st, 96)), and(v, _M64)))
        v := grev(mload(add(ptr, 32))) // lanes 4..7
        mstore(add(st, 128), xor(mload(add(st, 128)), shr(192, v)))
        mstore(add(st, 160), xor(mload(add(st, 160)), and(shr(128, v), _M64)))
        mstore(add(st, 192), xor(mload(add(st, 192)), and(shr(64, v), _M64)))
        mstore(add(st, 224), xor(mload(add(st, 224)), and(v, _M64)))
        v := grev(mload(add(ptr, 64))) // lanes 8..11
        mstore(add(st, 256), xor(mload(add(st, 256)), shr(192, v)))
        mstore(add(st, 288), xor(mload(add(st, 288)), and(shr(128, v), _M64)))
        mstore(add(st, 320), xor(mload(add(st, 320)), and(shr(64, v), _M64)))
        mstore(add(st, 352), xor(mload(add(st, 352)), and(v, _M64)))
        v := grev(mload(add(ptr, 96))) // lanes 12..15
        mstore(add(st, 384), xor(mload(add(st, 384)), shr(192, v)))
        mstore(add(st, 416), xor(mload(add(st, 416)), and(shr(128, v), _M64)))
        mstore(add(st, 448), xor(mload(add(st, 448)), and(shr(64, v), _M64)))
        mstore(add(st, 480), xor(mload(add(st, 480)), and(v, _M64)))
        v := grev(mload(add(ptr, 128))) // lane 16 (bytes 128..135 only)
        mstore(add(st, 512), xor(mload(add(st, 512)), shr(192, v)))
    }
}

/// @dev Write one full 136-byte squeeze block from the state to memory at `outPtr`.
///      Writes 160 bytes (the last word spills 24 bytes of garbage past the block);
///      callers must only consume 136 bytes and may let later writes overwrite the rest.
function _squeezeBlockFast(uint256[25] memory st, uint256 outPtr) pure {
    assembly {
        function grev(w) -> v {
            v := or(
                and(shl(8, w), 0xff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00),
                and(shr(8, w), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)
            )
            v := or(
                and(shl(16, v), 0xffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000),
                and(shr(16, v), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)
            )
            v := or(
                and(shl(32, v), 0xffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000),
                and(shr(32, v), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff)
            )
        }
        mstore(
            outPtr,
            grev(or(or(or(shl(192, mload(st)), shl(128, mload(add(st, 32)))), shl(64, mload(add(st, 64)))), mload(add(st, 96))))
        )
        mstore(
            add(outPtr, 32),
            grev(
                or(
                    or(or(shl(192, mload(add(st, 128))), shl(128, mload(add(st, 160)))), shl(64, mload(add(st, 192)))),
                    mload(add(st, 224))
                )
            )
        )
        mstore(
            add(outPtr, 64),
            grev(
                or(
                    or(or(shl(192, mload(add(st, 256))), shl(128, mload(add(st, 288)))), shl(64, mload(add(st, 320)))),
                    mload(add(st, 352))
                )
            )
        )
        mstore(
            add(outPtr, 96),
            grev(
                or(
                    or(or(shl(192, mload(add(st, 384))), shl(128, mload(add(st, 416)))), shl(64, mload(add(st, 448)))),
                    mload(add(st, 480))
                )
            )
        )
        mstore(
            add(outPtr, 128),
            grev(
                or(
                    or(or(shl(192, mload(add(st, 512))), shl(128, mload(add(st, 544)))), shl(64, mload(add(st, 576)))),
                    mload(add(st, 608))
                )
            )
        )
    }
}

/// @notice Minimal SHAKE256 XOF built on f1600Fast.
/// @dev Rate 136 bytes, 0x1f domain padding, 0x80 final bit. Absorb and squeeze are
///      word-wise (full 32-byte loads/stores with in-word byte reversal), multi-block safe.
function shake256Fast(bytes memory input, uint256 outLen) pure returns (bytes memory output) {
    uint256[25] memory st; // zero-initialized sponge state
    uint256 ptr;
    uint256 len = input.length;
    assembly {
        ptr := add(input, 32)
    }
    unchecked {
        // absorb full 136-byte blocks
        uint256 nFull = len / 136;
        for (uint256 i = 0; i < nFull; ++i) {
            _xorBlockFast(st, ptr);
            f1600Fast(st);
            ptr += 136;
        }
        // final (partial or empty) block with 0x1f ... 0x80 padding
        uint256 rem = len - nFull * 136;
        bytes memory last = new bytes(136); // zeroed
        assembly {
            let dst := add(last, 32)
            mcopy(dst, ptr, rem)
            mstore8(add(dst, rem), 0x1f)
            // byte 135 is the least significant byte of the word at offset 104
            mstore(add(dst, 104), xor(mload(add(dst, 104)), 0x80))
            ptr := dst
        }
        _xorBlockFast(st, ptr);
        f1600Fast(st);

        // squeeze
        output = new bytes(outLen);
        uint256 outPtr;
        assembly {
            outPtr := add(output, 32)
        }
        uint256 done = 0;
        while (true) {
            // writes a full 136(+24 spill)-byte block; the spill lands in free memory
            // or is overwritten by the next block
            _squeezeBlockFast(st, outPtr + done);
            done += 136;
            if (done >= outLen) break;
            f1600Fast(st);
        }
    }
}
